<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.tally</groupId>
  <artifactId>tally</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>tally</name>
  <description>Double-entry money-movement service on the Java standard library.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>6.1.1</junit.version>
    <!-- integration tests need a live Postgres, and race-demo tests assert corruption or
         deadlock, so the default build skips both. Profiles below re-enable each on demand. -->
    <surefire.groups></surefire.groups>
    <surefire.excludedGroups>integration,race-demo</surefire.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The JDBC driver, the second and last third-party dependency before hardening. There is no
         database client in the JDK, and the store talks to Postgres over plain JDBC. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.12</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- One predictable artifact name, target/tally.jar, for the Dockerfile and the run scripts. -->
    <finalName>tally</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <!-- Surefire below 3.5.4 cannot run JUnit 6, it loads a 1.x platform launcher. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <groups>${surefire.groups}</groups>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <!-- One executable jar. The only thing shaded in is the already-justified PG driver. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- This app is an artifact to run, not a library others depend on, so the reduced pom is noise. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- The PG driver registers itself through META-INF/services. Without this
                     transformer the shaded jar loses the java.sql.Driver entry and
                     DriverManager finds nothing. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.tally.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- -Pintegration runs the database tests too, but must still exclude the demos. -->
    <profile>
      <id>integration</id>
      <properties>
        <surefire.excludedGroups>race-demo</surefire.excludedGroups>
      </properties>
    </profile>
    <!-- ./mvnw test -Prace-demo runs only the corruption and deadlock demos. -->
    <profile>
      <id>race-demo</id>
      <properties>
        <surefire.groups>race-demo</surefire.groups>
        <surefire.excludedGroups></surefire.excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
