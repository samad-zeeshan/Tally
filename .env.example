# Copy this file to .env, fill both values in, then run: docker compose up --build
# .env is gitignored. Nothing in it is ever committed, and compose refuses to start if either is unset.

# The Postgres password. Any long random string; it never leaves the compose network.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# The API bearer token. At least 16 characters or the app exits at startup (Auth.requireToken).
#   openssl rand -hex 24
# This one is also baked into the served JavaScript so the one-origin demo can create and transfer, which
# means anyone who opens the page has it. That is fine for a throwaway local value and is not fine for
# anything else: it is a demo credential, never a real secret.
TALLY_API_TOKEN=
